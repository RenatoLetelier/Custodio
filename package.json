{
  "name": "custodio",
  "version": "0.0.0",
  "private": true,
  "description": "Custodio: gestor de discos y respaldos",
  "author": "Renato Letelier",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/custodio-service",
    "packages/custodio-ui"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "e2e:ui": "npm run e2e:ui -w custodio-ui",
    "build:ui": "npm run build -w custodio-ui",
    "dist:win": "npm run dist:win -w custodio-ui",
    "contracts": "npm run contracts -w custodio-service",
    "acceptance": "tsx scripts/acceptance.ts",
    "verify": "tsx scripts/verify.ts"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.24.10",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}

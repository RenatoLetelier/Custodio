{
  "name": "custodio-ui",
  "productName": "Custodio",
  "version": "0.0.0",
  "private": true,
  "description": "Aplicación de escritorio de Custodio",
  "author": "Renato Letelier",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.ui.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/ui/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "e2e:ui": "playwright test",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "verify": "tsx ../../scripts/verify.ts --scope=ui",
    "postinstall": "install-electron"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "7.3.7",
    "yaml": "2.9.1"
  }
}
